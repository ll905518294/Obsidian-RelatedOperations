{
	"name": "obsidian-vault-doctor",
	"version": "1.9.4",
	"description": "Inspect Vault health, find broken links and unreferenced resources, and organize related notes.",
	"main": "main.js",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"deploy": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-and-restart.ps1",
		"deploy:check": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-and-restart.ps1 -CheckOnly",
		"test": "node --test --experimental-strip-types tests/**/*.test.mjs",
		"test:deploy": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-and-restart.tests.ps1",
		"package": "node scripts/package-plugin.mjs",
		"package:check": "node scripts/package-plugin.mjs --check",
		"release:check": "node scripts/release-check.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "^1.13.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
